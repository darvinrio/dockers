# Dashboard login
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password
HERMES_DASHBOARD_BASIC_AUTH_SECRET=replace-with-a-long-random-session-secret
HERMES_GATEWAY_NO_SUPERVISE=1

# Gateway/API authentication, if enabling the API server
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
API_SERVER_KEY=replace-with-another-long-random-key

# Provider key; choose the provider you actually use
OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
